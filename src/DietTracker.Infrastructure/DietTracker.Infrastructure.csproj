<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>DietTracker.Infrastructure</RootNamespace>
    <AssemblyName>DietTracker.Infrastructure</AssemblyName>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Google.Apis.Drive.v3" />
    <PackageReference Include="Google.Apis.Auth" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DietTracker.Core\DietTracker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared cross-cutting namespaces used by most infrastructure types. -->
    <Using Include="DietTracker.Infrastructure.Authentication" />
    <Using Include="DietTracker.Infrastructure.Database" />
    <Using Include="DietTracker.Infrastructure.Security" />
    <Using Include="DietTracker.Infrastructure.FileStorage" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Database\Migrations\*.sql" />
  </ItemGroup>

</Project>
