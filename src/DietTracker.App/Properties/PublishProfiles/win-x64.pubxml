<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile referenced by DietTracker.App.csproj (PublishProfile=win-$(Platform).pubxml).

  The file must exist: without it MSBuild falls back to a RID-less publish (warning NETSDK1198),
  which copies the native assets of EVERY runtimeIdentifier declared by the NuGet dependencies
  into the payload - SQLitePCLRaw for 20+ platforms, OnnxRuntime and DirectML for
  win-arm64/win-arm64ec, win-x86, ... That dead weight (about 48 MB compressed) lands in the
  .msix and makes every install and uninstall slower. Pinning the RuntimeIdentifier here lets
  the publish prune everything this architecture does not need.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>