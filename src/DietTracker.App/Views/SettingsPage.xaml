<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DietTracker.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DietTracker.App.Controls">

    <Page.Resources>
        <!-- The window height is fixed to the dashboard, so this page uses that whole height instead
             of packing everything at the top: the cards keep the generous padding of the dashboard
             cards, the elements inside a card are spaced wider apart and the star rows of the grid
             (see UpdateContentHeight in the code-behind) stretch the panels down to the bottom of
             the window. -->
        <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource ProgressCardStyle}">
            <Setter Property="Padding" Value="24,20" />
        </Style>
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderStyle}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="ScrollHost" Padding="24,24,24,32">
        <!-- The MinHeight is kept equal to the viewport (UpdateContentHeight) and the star rows below
             absorb everything the fixed content leaves over, so the page covers the whole window. -->
        <Grid x:Name="RootLayout" MaxWidth="{StaticResource PageMaxContentWidth}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,16"
                Style="{StaticResource PageTitleStyle}"
                x:Uid="Settings_Title"
                Text="Settings" />

            <!-- Guest mode: the page explains what happens without an account, so the answer is the
                 first thing read instead of being hidden on a separate page. -->
            <InfoBar
                Grid.Row="1"
                Margin="0,0,0,20"
                x:Uid="Account_GuestInfo"
                IsOpen="{x:Bind ViewModel.IsGuest, Mode=OneWay}"
                Severity="Informational"
                IsClosable="False"
                Title="You are using Diet Tracker without an account"
                Message="{x:Bind ViewModel.PrivacySummary, Mode=OneWay}" />

            <!-- One grid instead of two independent columns: a card fills its cell, so the two cards of
                 a row always share the same top and bottom edge. The row grows with the taller card of
                 the pair (a card needs more height, the row follows) and the star rows share the height
                 the viewport leaves over, which is what stretches the panels to the bottom of the
                 fixed-height window no matter how long a caption or a localized label is. -->
            <Grid Grid.Row="2" ColumnSpacing="24" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <!-- Row 0 left: the connected account - e-mail, provider, remaining cloud space,
                     sign-in state and what the account stores. The e-mail comes first and the sign-in
                     button sits directly below it, so connecting or disconnecting never needs a second
                     screen. -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" x:Uid="Settings_Account" Text="Account" />

                        <TextBlock
                            Text="{x:Bind ViewModel.AccountEmailText, Mode=OneWay}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />

                        <!-- Provider and remaining cloud space share one line: two short facts do not
                             need two rows on a card this wide. A Grid (not a horizontal StackPanel)
                             lets the provider caption wrap when the window is narrow. -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.AccountDetailText, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.QuotaText, Mode=OneWay}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="Account_Google"
                                Content="Sign in with Google"
                                Style="{StaticResource AccentButtonStyle}"
                                MinWidth="180"
                                Command="{x:Bind ViewModel.SignInGoogleCommand}"
                                Visibility="{x:Bind ViewModel.SignInVisibility, Mode=OneWay}" />
                            <Button
                                x:Uid="Account_SignOut"
                                Content="Sign out"
                                MinWidth="140"
                                Command="{x:Bind ViewModel.SignOutCommand}"
                                Visibility="{x:Bind ViewModel.SignedInVisibility, Mode=OneWay}" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsAccountBusy, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.AccountStatusMessage, Mode=OneWay}" />

                        <!-- There is no "upload my meals" switch any more: signing in is the consent,
                             and these two captions say exactly what the account keeps. -->
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.CloudSaveText}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.ConsentText}" />
                    </StackPanel>
                </Border>

                <!-- Row 0 right: the local switches. There is no Save button - every switch (and the
                     automatic synchronization interval) is written the moment it changes, and the
                     caption under them confirms the write. -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" x:Uid="Settings_General" Text="General" />
                        <TextBlock Style="{StaticResource CaptionStyle}" x:Uid="Settings_AutoSaveHint" Text="Every change is saved immediately; the page has no Save button." />

                        <ToggleSwitch x:Uid="Settings_Reminders" Header="Reminders" IsOn="{x:Bind ViewModel.RemindersEnabled, Mode=TwoWay}" />
                        <ToggleSwitch x:Uid="Settings_StartWithWindows" Header="Start with Windows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                        <ToggleSwitch x:Uid="Settings_MinimizeToTray" Header="Minimize to the notification area" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                        <ToggleSwitch x:Uid="Settings_12Hour" Header="Use the 12 hour clock" IsOn="{x:Bind ViewModel.Use12HourClock, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- Row 1 left: what the engine really reports, the schedule, a manual cycle and the
                     two restore actions. Buttons wrap through UniformWrapPanel, so a narrow window
                     moves "Restore from the cloud" to a second line instead of clipping it. -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" x:Uid="Settings_Sync" Text="Synchronization" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SyncStateText, Mode=OneWay}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Text="{x:Bind ViewModel.LastSyncText, Mode=OneWay}" />
                        </Grid>

                        <!-- How often the cloud is contacted on its own; the journal is kept in any
                             case, so an edit is never at risk while it waits for the schedule. -->
                        <ComboBox
                            x:Uid="Settings_SyncFrequency"
                            Header="Automatic synchronization"
                            ItemsSource="{x:Bind ViewModel.SyncFrequencyOptions}"
                            DisplayMemberPath="DisplayName"
                            SelectedValuePath="Tag"
                            SelectedValue="{x:Bind ViewModel.SelectedSyncFrequency, Mode=TwoWay}" />
                        <TextBlock
                            Style="{StaticResource CaptionStyle}"
                            x:Uid="Settings_SyncFrequencyHint"
                            Text="Meals and photographs are uploaded as soon as they are saved; the schedule above decides how often the app also checks the cloud for changes made on other devices." />

                        <!-- A Grid (not a horizontal StackPanel) gives the wrap panel the real width it
                             may fill; the ring keeps its own column. -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:UniformWrapPanel
                                Grid.Column="0"
                                UniformHeight="False"
                                MinItemWidth="150"
                                HorizontalSpacing="8"
                                VerticalSpacing="8">
                                <Button
                                    x:Uid="Settings_SyncNow"
                                    Content="Synchronize now"
                                    Command="{x:Bind ViewModel.SyncNowCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}" />
                                <Button
                                    x:Uid="Account_Preview"
                                    Content="What is in the cloud?"
                                    Command="{x:Bind ViewModel.PreviewRestoreCommand}"
                                    Visibility="{x:Bind ViewModel.SignedInVisibility, Mode=OneWay}" />
                                <Button
                                    x:Uid="Account_Restore"
                                    Content="Restore from the cloud"
                                    Command="{x:Bind ViewModel.RestoreCommand}"
                                    Visibility="{x:Bind ViewModel.SignedInVisibility, Mode=OneWay}" />
                            </controls:UniformWrapPanel>
                            <ProgressRing
                                Grid.Column="1"
                                IsActive="{x:Bind ViewModel.IsSyncBusy, Mode=OneWay}"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.SyncStatusMessage, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- Row 1 right: privacy and backup in one card. The storage facts belong to the
                     export, so they share the card, and the three actions that remain are the three
                     that never remove anything: export (backup archive or PDF report), restore a
                     backup and verify the database. The destructive buttons are gone on purpose. -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" x:Uid="Settings_PrivacyAndBackup" Text="Privacy and backup" />
                        <TextBlock Style="{StaticResource CaptionStyle}" x:Uid="Settings_PrivacyHint" Text="Your data stays on this device unless you are signed in. Export writes a backup archive or a printable PDF report; restoring merges a backup; the integrity check only reads the database." />

                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.StorageText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.DatabasePath}" IsTextSelectionEnabled="True" />

                        <controls:UniformWrapPanel UniformHeight="False" MinItemWidth="120" HorizontalSpacing="8" VerticalSpacing="8">
                            <Button x:Uid="Settings_Export" Content="Export data" Command="{x:Bind ViewModel.ExportDataCommand}" />
                            <Button x:Uid="Settings_Import" Content="Restore backup" Command="{x:Bind ViewModel.ImportBackupCommand}" />
                            <Button x:Uid="Settings_Integrity" Content="Check integrity" Command="{x:Bind ViewModel.CheckIntegrityCommand}" />
                        </controls:UniformWrapPanel>

                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.BackupStatusMessage, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- Row 2: About spans both columns, so the page ends on one full width card instead
                     of a card that is left hanging next to the empty cell of the shorter column. -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" x:Uid="Settings_About" Text="About" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.AboutText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
