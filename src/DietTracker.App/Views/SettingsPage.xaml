<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DietTracker.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DietTracker.App.ViewModels">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="16" MaxWidth="900">

            <TextBlock Style="{StaticResource PageTitleStyle}" x:Uid="Settings_Title" Text="Settings" />

            <Border Style="{StaticResource ProgressCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="Settings_General" Text="General" />

                    <ComboBox
                        x:Uid="Settings_Language"
                        Header="Language"
                        ItemsSource="{x:Bind ViewModel.Languages}"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Tag"
                        SelectedValue="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />

                    <ToggleSwitch x:Uid="Settings_Reminders" Header="Reminders" IsOn="{x:Bind ViewModel.RemindersEnabled, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="Settings_StartWithWindows" Header="Start with Windows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="Settings_MinimizeToTray" Header="Minimize to the notification area" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="Settings_12Hour" Header="Use the 12 hour clock" IsOn="{x:Bind ViewModel.Use12HourClock, Mode=TwoWay}" />

                    <Button x:Uid="Common_Save" Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ProgressCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="Settings_Backup" Text="Backup" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.StorageText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.DatabasePath}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Settings_Export" Content="Export data" Command="{x:Bind ViewModel.ExportBackupCommand}" />
                        <Button x:Uid="Settings_Import" Content="Restore backup" Command="{x:Bind ViewModel.ImportBackupCommand}" />
                        <Button x:Uid="Settings_Integrity" Content="Check integrity" Command="{x:Bind ViewModel.CheckIntegrityCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ProgressCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="Settings_Privacy" Text="Privacy" />
                    <TextBlock Style="{StaticResource CaptionStyle}" x:Uid="Settings_PrivacyHint" Text="These actions are independent: signing out, disabling synchronization, deleting local data and deleting cloud data." />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Settings_DisableSync" Content="Disable synchronization" Command="{x:Bind ViewModel.DisableSynchronizationCommand}" />
                        <Button x:Uid="Settings_DeletePhotos" Content="Delete photographs" Command="{x:Bind ViewModel.DeletePhotographsCommand}" />
                        <Button x:Uid="Settings_DeleteLocal" Content="Delete local data" Command="{x:Bind ViewModel.DeleteLocalDataCommand}" />
                        <Button x:Uid="Settings_DeleteCloud" Content="Delete cloud data" Command="{x:Bind ViewModel.DeleteCloudDataCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ProgressCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="Settings_Sync" Text="Synchronization" />
                    <!-- How often the cloud is contacted on its own; the journal is kept in any case,
                         so an edit is never at risk while it waits for the schedule. -->
                    <ComboBox
                        x:Uid="Settings_SyncFrequency"
                        Header="Automatic synchronization"
                        ItemsSource="{x:Bind ViewModel.SyncFrequencyOptions}"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Tag"
                        SelectedValue="{x:Bind ViewModel.SelectedSyncFrequency, Mode=TwoWay}" />
                    <TextBlock
                        Style="{StaticResource CaptionStyle}"
                        x:Uid="Settings_SyncFrequencyHint"
                        Text="Edits are saved on this device immediately and uploaded when the schedule above is due, or when you press Synchronize now." />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.LastSyncText, Mode=OneWay}" />
                    <Button x:Uid="Settings_SyncNow" Content="Synchronize now" Command="{x:Bind ViewModel.SyncNowCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ProgressCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="Settings_About" Text="About" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.AboutText, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
