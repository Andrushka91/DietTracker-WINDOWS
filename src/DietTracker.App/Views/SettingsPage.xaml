<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DietTracker.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DietTracker.App.Controls">

    <Page.Resources>
        <!-- The window height is fixed to the dashboard, so this page uses that whole height instead
             of packing everything at the top: the cards keep the generous padding of the dashboard
             cards, the elements inside a card are spaced wider apart and the star rows of the grid
             (see UpdateContentHeight in the code-behind) stretch the panels down to the bottom of
             the window. -->
        <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource ProgressCardStyle}">
            <!-- Uniform on all four sides: the right-aligned action rows then sit on exactly the
                 same padding as the last row at the bottom of every card. -->
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderStyle}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <!-- One step above the shared caption (12 px): every supporting line of this page uses it, so
             the text reads as comfortably as the wider panels it sits in. -->
        <Style x:Key="SettingsCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <!-- Header of the switches and of the synchronization combo box: the controls ship their own
             14 px header, this template gives them the larger size used everywhere else on the page. -->
        <DataTemplate x:Key="SettingsHeaderTemplate">
            <TextBlock Text="{Binding}" FontSize="16" TextWrapping="Wrap" />
        </DataTemplate>
    </Page.Resources>

    <!-- Symmetrical on all four sides: the bottom carries the same 24 px as the top and the sides.
         The page has no status line of its own any more - confirmations float over it (see the
         frameless line at the bottom) - so this padding does not have to be sacrificed to make room
         for them. -->
    <ScrollViewer x:Name="ScrollHost" Padding="24">
        <!-- The MinHeight is kept equal to the viewport (UpdateContentHeight) and the star rows below
             absorb everything the fixed content leaves over, so the page covers the whole window. -->
        <Grid x:Name="RootLayout" MaxWidth="{StaticResource PageMaxContentWidth}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,16"
                Style="{StaticResource PageTitleStyle}"
                x:Uid="Settings_Title"
                Text="Settings" />

            <!-- Guest mode: the page explains what happens without an account, so the answer is the
                 first thing read instead of being hidden on a separate page. -->
            <InfoBar
                Grid.Row="1"
                Margin="0,0,0,20"
                x:Uid="Account_GuestInfo"
                IsOpen="{x:Bind ViewModel.IsGuest, Mode=OneWay}"
                Severity="Informational"
                IsClosable="False"
                Title="You are using Diet Tracker without an account"
                Message="{x:Bind ViewModel.PrivacySummary, Mode=OneWay}" />

            <!-- One grid instead of two independent columns: a card fills its cell, so the two cards of
                 a row always share the same top and bottom edge. The row grows with the taller card of
                 the pair (a card needs more height, the row follows) and the star rows share the height
                 the viewport leaves over, which is what stretches the panels to the bottom of the
                 fixed-height window no matter how long a caption or a localized label is. -->
            <Grid Grid.Row="2" ColumnSpacing="24" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <!-- Row 0 left: the connected account. The title stays on top, the framed user glyph
                     fills the free space under it and everything else forms one contiguous block at
                     the bottom: provider/quota line, identity, sign-in button and the texts that
                     explain what an account keeps. The block starts 14 px below the glyph - the same
                     gap the other icon panels (Synchronization, Privacy and backup) leave under
                     theirs - and every following element is 14 px below the previous one, so
                     "Not signed in" sits right above the button and the button right above its
                     texts. Auto rows with per-element margins keep that rhythm even when a line
                     collapses (the confirmation is empty), and the star row above pushes the whole
                     block onto the bottom padding of the card. -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SettingsSectionHeaderStyle}" x:Uid="Settings_Account" Text="Account" />

                        <!-- The free space under the title carries the framed user glyph, pinned to the
                             left so the tile lines up with the text below it. When the connected account
                             has a photo, the picture fills this very tile instead of the glyph - the tile
                             itself (120 x 120, frame and rounding) does not change; without a photo the
                             glyph stays exactly as it is. -->
                        <Border
                            Grid.Row="1"
                            Width="120"
                            Height="120"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource GalleryFillBrush}"
                            BorderBrush="{StaticResource GalleryBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="{StaticResource CardCornerRadius}">
                            <Grid>
                                <FontIcon
                                    Glyph="&#xE77B;"
                                    FontSize="64"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource SubtleTextBrush}"
                                    Visibility="{x:Bind ViewModel.AccountPlaceholderVisibility, Mode=OneWay}" />
                                <Border CornerRadius="{StaticResource CardCornerRadius}">
                                    <Image
                                        x:Name="AccountPhotoImage"
                                        Source="{x:Bind ViewModel.AccountPhotoUrl, Mode=OneWay, Converter={StaticResource StringToImageSource}}"
                                        Stretch="UniformToFill"
                                        Visibility="{x:Bind ViewModel.AccountPhotoVisibility, Mode=OneWay}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- The block sits 14 px under the glyph tile, exactly like the text of the
                             Synchronization and Privacy and backup panels sits under theirs. -->
                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Provider and remaining cloud space share one line: two short facts do not
                                 need two rows on a card this wide. A Grid (not a horizontal StackPanel)
                                 lets the provider caption wrap when the window is narrow. -->
                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource SettingsCaptionStyle}" Text="{x:Bind ViewModel.AccountDetailText, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsCaptionStyle}" Text="{x:Bind ViewModel.QuotaText, Mode=OneWay}" />
                            </Grid>

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,14,0,0"
                                Text="{x:Bind ViewModel.AccountEmailText, Mode=OneWay}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True" />

                            <StackPanel Grid.Row="2" Margin="0,14,0,0" Orientation="Horizontal" Spacing="12">
                                <Button
                                    x:Uid="Account_Google"
                                    Content="Sign in with Google"
                                    FontSize="15"
                                    Style="{StaticResource AccentButtonStyle}"
                                    MinWidth="180"
                                    Command="{x:Bind ViewModel.SignInGoogleCommand}"
                                    Visibility="{x:Bind ViewModel.SignInVisibility, Mode=OneWay}" />
                                <Button
                                    x:Uid="Account_SignOut"
                                    Content="Sign out"
                                    FontSize="15"
                                    MinWidth="140"
                                    Command="{x:Bind ViewModel.SignOutCommand}"
                                    Visibility="{x:Bind ViewModel.SignedInVisibility, Mode=OneWay}" />
                            </StackPanel>

                            <!-- There is no "upload my meals" switch any more: signing in is the consent,
                                 and these two captions say exactly what the account keeps. -->
                            <TextBlock Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource SettingsCaptionStyle}" Text="{x:Bind ViewModel.CloudSaveText}" />
                            <TextBlock Grid.Row="4" Margin="0,14,0,0" Style="{StaticResource SettingsCaptionStyle}" Text="{x:Bind ViewModel.ConsentText}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Row 0 right: the local switches. There is no Save button - every switch (and the
                     automatic synchronization interval) is written the moment it changes. The
                     switches live in auto rows separated by starred gaps, so they spread evenly over
                     the whole height of the panel; the last visible row ends on the bottom padding of
                     the card (the confirmation of a change is not part of this layout any more, it
                     floats over the page - see the frameless line at the bottom of the page). There is no
                     Reminders switch: no reminder can exist (nothing in the application creates one),
                     so a switch that gates an empty list would only pretend to be a setting. -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SettingsSectionHeaderStyle}" x:Uid="Settings_General" Text="General" />
                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsCaptionStyle}" x:Uid="Settings_AutoSaveHint" Text="Every change is saved immediately; the page has no Save button." />

                        <ToggleSwitch Grid.Row="3" FontSize="16" x:Uid="Settings_StartWithWindows" Header="Start with Windows" HeaderTemplate="{StaticResource SettingsHeaderTemplate}" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                        <ToggleSwitch Grid.Row="5" FontSize="16" x:Uid="Settings_MinimizeToTray" Header="Minimize to the notification area" HeaderTemplate="{StaticResource SettingsHeaderTemplate}" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                        <ToggleSwitch Grid.Row="7" FontSize="16" x:Uid="Settings_12Hour" Header="Use the 12 hour clock" HeaderTemplate="{StaticResource SettingsHeaderTemplate}" IsOn="{x:Bind ViewModel.Use12HourClock, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!-- Row 1 left: everything the engine really reports, pushed to the bottom of the
                     panel. A framed sync glyph sits on the left under the title; below it the state
                     line, the schedule, the hint and the confirmation follow in one contiguous
                     block (14 px apart) and the actions close the card right-aligned on the tight
                     footer padding this card overrides (12 on the right and 12 on the bottom
                     instead of the shared 24), so "Synchronize now" sits close to the bottom-right
                     corner. Buttons wrap through UniformWrapPanel, so a narrow window moves
                     "Restore from the cloud" to a second line. -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsCardStyle}" Padding="24,24,12,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SettingsSectionHeaderStyle}" x:Uid="Settings_Sync" Text="Synchronization" />

                        <Border
                            Grid.Row="1"
                            Width="120"
                            Height="120"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource GalleryFillBrush}"
                            BorderBrush="{StaticResource GalleryBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="{StaticResource CardCornerRadius}">
                            <FontIcon
                                Glyph="&#xE72C;"
                                FontSize="64"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource SubtleTextBrush}" />
                        </Border>

                        <Grid Grid.Row="2" Margin="0,14,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SyncStateText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Style="{StaticResource SettingsCaptionStyle}" VerticalAlignment="Center" Text="{x:Bind ViewModel.LastSyncText, Mode=OneWay}" />
                        </Grid>

                        <!-- How often the cloud is contacted on its own; the journal is kept in any
                             case, so an edit is never at risk while it waits for the schedule. -->
                        <ComboBox
                            Grid.Row="3"
                            Margin="0,14,0,0"
                            x:Uid="Settings_SyncFrequency"
                            Header="Automatic synchronization"
                            HeaderTemplate="{StaticResource SettingsHeaderTemplate}"
                            FontSize="16"
                            ItemsSource="{x:Bind ViewModel.SyncFrequencyOptions}"
                            DisplayMemberPath="DisplayName"
                            SelectedValuePath="Tag"
                            SelectedValue="{x:Bind ViewModel.SelectedSyncFrequency, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="4"
                            Margin="0,14,0,0"
                            Style="{StaticResource SettingsCaptionStyle}"
                            x:Uid="Settings_SyncFrequencyHint"
                            Text="Meals and photographs are uploaded as soon as they are saved; the schedule above decides how often the app also checks the cloud for changes made on other devices." />

                        <!-- A wrap panel (not a horizontal StackPanel) keeps the row wrappable on narrow
                             windows; being right-aligned it ends exactly on the card's right padding,
                             the same value as the bottom rows. The busy state needs no spinner here:
                             every cycle opens the full-window overlay (Busy_Synchronizing /
                             Busy_Restoring) with its own ring, message and closing block, so
                             nothing can push these buttons off the edge. -->
                        <controls:UniformWrapPanel
                            Grid.Row="5"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Right"
                            UniformHeight="False"
                            MinItemWidth="150"
                            HorizontalSpacing="8"
                            VerticalSpacing="8">
                            <Button
                                x:Uid="Settings_SyncNow"
                                Content="Synchronize now"
                                FontSize="15"
                                Command="{x:Bind ViewModel.SyncNowCommand}"
                                IsEnabled="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}" />
                            <Button
                                x:Uid="Account_Preview"
                                Content="What is in the cloud?"
                                FontSize="15"
                                Command="{x:Bind ViewModel.PreviewRestoreCommand}"
                                Visibility="{x:Bind ViewModel.SignedInVisibility, Mode=OneWay}" />
                            <Button
                                x:Uid="Account_Restore"
                                Content="Restore from the cloud"
                                FontSize="15"
                                Command="{x:Bind ViewModel.RestoreCommand}"
                                Visibility="{x:Bind ViewModel.SignedInVisibility, Mode=OneWay}" />
                        </controls:UniformWrapPanel>
                    </Grid>
                </Border>

                <!-- Row 1 right: privacy and backup in one card with everything pushed to the bottom:
                     a framed lock glyph sits on the left under the title, the explanatory texts
                     and the confirmation form the bottom block (directly above the actions) and
                     the three buttons close the card right-aligned on the tight footer padding
                     this card overrides (12 on the right and 12 on the bottom instead of the
                     shared 24), so they sit close to the bottom-right corner. The three actions
                     are the three that never remove anything: export (backup archive or PDF
                     report), restore a backup and verify the database. The destructive buttons
                     are gone on purpose. -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsCardStyle}" Padding="24,24,12,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SettingsSectionHeaderStyle}" x:Uid="Settings_PrivacyAndBackup" Text="Privacy and backup" />

                        <Border
                            Grid.Row="1"
                            Width="120"
                            Height="120"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource GalleryFillBrush}"
                            BorderBrush="{StaticResource GalleryBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="{StaticResource CardCornerRadius}">
                            <FontIcon
                                Glyph="&#xE72E;"
                                FontSize="64"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource SubtleTextBrush}" />
                        </Border>

                        <StackPanel Grid.Row="2" Margin="0,14,0,0" Spacing="14">
                            <TextBlock Style="{StaticResource SettingsCaptionStyle}" x:Uid="Settings_PrivacyHint" Text="Your data stays on this device unless you are signed in. Export writes a backup archive or a printable PDF report; restoring merges a backup; the integrity check only reads the database." />

                            <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="{x:Bind ViewModel.StorageText, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="{x:Bind ViewModel.DatabasePath}" IsTextSelectionEnabled="True" />
                        </StackPanel>

                        <controls:UniformWrapPanel
                            Grid.Row="3"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Right"
                            UniformHeight="False"
                            MinItemWidth="120"
                            HorizontalSpacing="8"
                            VerticalSpacing="8">
                            <Button x:Uid="Settings_Export" Content="Export data" FontSize="15" Command="{x:Bind ViewModel.ExportDataCommand}" />
                            <Button x:Uid="Settings_Import" Content="Restore backup" FontSize="15" Command="{x:Bind ViewModel.ImportBackupCommand}" />
                            <Button x:Uid="Settings_Integrity" Content="Check integrity" FontSize="15" Command="{x:Bind ViewModel.CheckIntegrityCommand}" />
                        </controls:UniformWrapPanel>
                    </Grid>
                </Border>

                <!-- Row 2: About spans both columns, so the page ends on one full width card instead
                     of a card that is left hanging next to the empty cell of the shorter column.
                     The star row drops the text to the bottom, so it ends on the same padding as
                     the last row of every other card. -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SettingsSectionHeaderStyle}" x:Uid="Settings_About" Text="About" />
                        <TextBlock Grid.Row="2" Style="{StaticResource SettingsCaptionStyle}" Text="{x:Bind ViewModel.AboutText, Mode=OneWay}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Confirmation of the last action ("Your settings were saved.", "Backup created ...",
                 the result of an integrity check, a synchronization). It deliberately is not a row
                 of the card it belongs to: the cards have no spare height - the page fills the
                 window exactly - so a line that arrived inside one pushed every row below it down
                 and put the page into a scrollbar. Floating over the empty bottom-right corner of
                 the About card it costs no layout at all: a toggle or a button never moves a card.
                 The line carries no frame: a border made the text read like a button, the message
                 alone is clearer. -->
            <TextBlock
                Grid.Row="0"
                Grid.RowSpan="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                MaxWidth="460"
                Margin="14,10"
                Style="{StaticResource SettingsCaptionStyle}"
                Text="{x:Bind ViewModel.ActiveStatusMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.ActiveStatusMessage, Converter={StaticResource StringToVisibility}, Mode=OneWay}" />
        </Grid>
    </ScrollViewer>
</Page>
