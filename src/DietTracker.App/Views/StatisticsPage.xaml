<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DietTracker.App.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DietTracker.App.Controls"
    xmlns:vm="using:DietTracker.App.ViewModels">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="16" MaxWidth="{StaticResource PageMaxContentWidth}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource PageTitleStyle}" x:Uid="Statistics_Title" Text="Progress and statistics" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.PeriodLabel, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="Statistics_PreviousWeek" Content="Previous week" Command="{x:Bind ViewModel.PreviousWeekCommand}" />
                    <Button x:Uid="Statistics_ThisWeek" Content="This week" Command="{x:Bind ViewModel.ThisWeekCommand}" />
                    <Button x:Uid="Statistics_NextWeek" Content="Next week" Command="{x:Bind ViewModel.NextWeekCommand}" />
                </StackPanel>
            </Grid>

            <!-- The three progress cards reflow into fewer columns on narrow windows -->
            <controls:UniformWrapPanel MinItemWidth="240" HorizontalSpacing="16" VerticalSpacing="16" UniformHeight="True">
                <Border Style="{StaticResource ProgressCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="Statistics_Daily" Text="Today" />
                        <ProgressBar Maximum="100" Value="{x:Bind ViewModel.DailyPercentage, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.DailyText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ProgressCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="Statistics_Weekly" Text="This week" />
                        <ProgressBar Maximum="100" Value="{x:Bind ViewModel.WeeklyPercentage, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.WeeklyText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.FullyCompletedText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ProgressCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="Statistics_Monthly" Text="This month" />
                        <ProgressBar Maximum="100" Value="{x:Bind ViewModel.MonthlyPercentage, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.MonthlyText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </controls:UniformWrapPanel>

            <!-- Weekly trend: one bar per day on a common baseline. The percentage is shown as text
                 (never as a tooltip: attaching tooltips from x:Bind during template instantiation makes
                 the native layout fail and used to crash the application). -->
            <Border Style="{StaticResource ProgressCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind ViewModel.TrendTitle, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Trend}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:UniformWrapPanel
                                    UniformHeight="False"
                                    MinItemWidth="44"
                                    HorizontalSpacing="4"
                                    VerticalSpacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrendBarViewModel">
                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Width="28"
                                        MinHeight="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Height="{x:Bind Percentage, Converter={StaticResource PercentageToWidth}, ConverterParameter=140}"
                                        Background="{StaticResource AccentStatusBrush}"
                                        CornerRadius="4" />

                                    <StackPanel Grid.Row="1" Spacing="2" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" Text="{x:Bind Label}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" Text="{x:Bind PercentageText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.Disclaimer, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
