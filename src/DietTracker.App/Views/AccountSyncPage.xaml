<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DietTracker.App.Views.AccountSyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="16" MaxWidth="900">

            <TextBlock Style="{StaticResource PageTitleStyle}" x:Uid="Account_Title" Text="Account and synchronization" />

            <InfoBar x:Uid="Account_GuestInfo" IsOpen="{x:Bind ViewModel.IsGuest, Mode=OneWay}" Severity="Informational" IsClosable="False"
                     Title="You are using DietTracker without an account"
                     Message="{x:Bind ViewModel.PrivacySummary}" />

            <Border Style="{StaticResource ProgressCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="Account_Current" Text="Connected account" />
                    <TextBlock Text="{x:Bind ViewModel.ProviderText, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.AccountText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.StateText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.LastSyncText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.QuotaText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

                    <ToggleSwitch
                        x:Uid="Account_Consent"
                        Header="Upload my meal data and photographs"
                        IsOn="{x:Bind ViewModel.ConsentGranted, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.ConsentText}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ProgressCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="Account_SignIn" Text="Sign in" />
                    <Button
                        x:Uid="Account_Google"
                        Content="Sign in with Google"
                        Command="{x:Bind ViewModel.SignInGoogleCommand}"
                        Visibility="{x:Bind ViewModel.SignInVisibility, Mode=OneWay}" />
                    <Button
                        x:Uid="Account_SignOut"
                        Content="Sign out"
                        Command="{x:Bind ViewModel.SignOutCommand}"
                        Visibility="{x:Bind ViewModel.SignedInVisibility, Mode=OneWay}" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ProgressCardStyle}"
                    Visibility="{x:Bind ViewModel.SignedInVisibility, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="Account_Sync" Text="Synchronization" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Settings_SyncNow" Content="Synchronize now" Command="{x:Bind ViewModel.SyncNowCommand}" />
                        <Button x:Uid="Account_Preview" Content="What is in the cloud?" Command="{x:Bind ViewModel.PreviewRestoreCommand}" />
                        <Button x:Uid="Account_Restore" Content="Restore from the cloud" Command="{x:Bind ViewModel.RestoreCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.StateText, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.EnvironmentText, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
