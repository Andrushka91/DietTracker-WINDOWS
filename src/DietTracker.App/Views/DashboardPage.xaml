<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DietTracker.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DietTracker.App.Controls">

    <!-- The ScrollViewer hands its content an infinite width. Capping the content stack to the page's
         own width keeps the two card columns inside the window at any window size or display scale,
         so the right column is never clipped; the window's own maximum width keeps the design cap.
         The padding is 16 on every side and the gap between the cards is 16 too, so the screen is
         symmetrical: |16|card|16|card|16| with the same 16 below the last row. -->
    <ScrollViewer
        x:Name="ScrollHost"
        Padding="16"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ContentRoot" Spacing="16">

            <!-- Daily progress: completed / total slots and the completion percentage -->
            <Border Style="{StaticResource ProgressCardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind ViewModel.DateLabel, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Dashboard_PreviousDay" Content="Previous" Command="{x:Bind ViewModel.PreviousDayCommand}" />
                            <Button x:Uid="Common_Today" Content="Today" Command="{x:Bind ViewModel.TodayCommand}" />
                            <Button x:Uid="Dashboard_NextDay" Content="Next" Command="{x:Bind ViewModel.NextDayCommand}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Maximum="100" Value="{x:Bind ViewModel.Percentage, Mode=OneWay}" />

                    <!-- Day state counters of the day: done (green), missed (red) and pending
                         (gray), each with its square colour chip, so the number carries the
                         same colour the cards and the calendar use. -->
                    <StackPanel Orientation="Horizontal" Spacing="28">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="18" Height="18" CornerRadius="4" Background="#FF107C10" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.DoneCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource CaptionStyle}" x:Uid="Dashboard_CountDone" Text="Done" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="18" Height="18" CornerRadius="4" Background="#FFA4262C" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.MissedCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource CaptionStyle}" x:Uid="Dashboard_CountMissed" Text="Missed" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="18" Height="18" CornerRadius="4" Background="#FF605E5C" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.PendingCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource CaptionStyle}" x:Uid="Dashboard_CountPending" Text="Pending" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- Day-wide status buttons, styled like the buttons inside the cards: the
                             check confirms every meal of this day, the cross marks them all missed.
                             Both are disabled on future days, whose meals stay pending. -->
                        <Button
                            Padding="7"
                            AutomationProperties.Name="Mark all meals as DONE"
                            ToolTipService.ToolTip="Mark all meals as DONE"
                            IsEnabled="{x:Bind ViewModel.CanMarkAllDone, Mode=OneWay}"
                            Command="{x:Bind ViewModel.MarkAllDoneCommand}">
                            <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="#FF107C10" />
                        </Button>
                        <Button
                            Padding="7"
                            AutomationProperties.Name="Mark all meals as MISSED"
                            ToolTipService.ToolTip="Mark all meals as MISSED"
                            IsEnabled="{x:Bind ViewModel.CanMarkAllMissed, Mode=OneWay}"
                            Command="{x:Bind ViewModel.MarkAllMissedCommand}">
                            <FontIcon Glyph="&#xE711;" FontSize="18" Foreground="#FFA4262C" />
                        </Button>
                        <Button x:Uid="Dashboard_SaveDayTemplate" Content="Save as template" Command="{x:Bind ViewModel.SaveDayTemplateCommand}" />
                        <!-- Saves every card that is open in inline editing with one press, so the
                             individual Save button of each card no longer has to be pressed one by
                             one. Enabled only while at least one editor is open (CanSaveAll); each
                             open card runs the same validation as its own Save button, so a card
                             whose title or description is still empty keeps its editor open and
                             shows the reason on its own error line while the others are written. -->
                        <Button
                            x:Uid="Dashboard_SaveAll"
                            Content="Save all"
                            IsEnabled="{x:Bind ViewModel.CanSaveAll, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SaveAllCommand}" />
                        <TextBlock
                            Style="{StaticResource CaptionStyle}"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The five permanent meal cards: always two cards per row (breakfast with morning snack,
                 lunch with afternoon snack) and the dinner card spans both columns, so the last row is
                 symmetric with the rows above it. All cards share the same height. -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:TwoColumnMealGridPanel
                            HorizontalSpacing="16"
                            VerticalSpacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:MealCardControl Card="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Loading indicator: collapsed when not loading, so it never leaves an empty gap
                 below the cards (an inactive ProgressRing still reserves its size otherwise). -->
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</Page>
