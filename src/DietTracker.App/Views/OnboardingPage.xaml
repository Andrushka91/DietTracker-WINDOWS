<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DietTracker.App.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="20" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind ViewModel.Title}" />

            <TextBlock Text="{x:Bind ViewModel.Description}" TextWrapping="Wrap" />

            <Border Style="{StaticResource ProgressCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="Onboarding_ChooseProvider" Text="Choose how to keep your data" />

                    <Button
                        x:Uid="Account_Microsoft"
                        Content="Sign in with Microsoft"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{x:Bind ViewModel.SignInMicrosoftCommand}" />

                    <Button
                        x:Uid="Account_Google"
                        Content="Sign in with Google"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{x:Bind ViewModel.SignInGoogleCommand}" />

                    <Button
                        x:Uid="Onboarding_ContinueWithoutAccount"
                        Content="Continue without an account"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{x:Bind ViewModel.ContinueAsGuestCommand}" />

                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.GuestDescription}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ProgressCardStyle}">
                <StackPanel Spacing="8">
                    <ToggleSwitch
                        x:Uid="Onboarding_Consent"
                        Header="I agree to upload my meal data and photographs to the account I choose"
                        IsOn="{x:Bind ViewModel.ConsentGranted, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.ConsentText}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</Page>
