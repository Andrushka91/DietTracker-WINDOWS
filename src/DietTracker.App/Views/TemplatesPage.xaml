<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DietTracker.App.Views.TemplatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DietTracker.App.ViewModels">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="16" MaxWidth="{StaticResource PageMaxContentWidth}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource PageTitleStyle}" x:Uid="Templates_Title" Text="Templates" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    x:Uid="Dashboard_SaveDayTemplate"
                    Content="Save day as template"
                    Command="{x:Bind ViewModel.SaveTodayCommand}" />
            </Grid>

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="{x:Bind ViewModel.EmptyText}"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Templates}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TemplateItemViewModel">
                        <Border Style="{StaticResource MealCardStyle}" Padding="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind KindLabel}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Summary}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind UpdatedText}" />
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    x:Uid="Template_Apply"
                                    Content="Apply to date"
                                    Tag="{x:Bind}"
                                    Click="OnApply" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                x:Uid="Template_Notice"
                Text="Templates never contain completion state or photographs." />
        </StackPanel>
    </ScrollViewer>
</Page>
