<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DietTracker.App.Converters">

    <converters:WidthMinusConverter x:Key="WidthMinus" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
    <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
    <converters:StringToImageSourceConverter x:Key="StringToImageSource" />
    <converters:TimeOnlyConverter x:Key="TimeOnly" />

    <!-- Dimensions of the permanent cards: every meal card has the same height and is laid out by
         TwoColumnMealGridPanel in a responsive grid, so the day stays readable at any window size.
         The height is sized for the compact inline editor (title, description, time, photo,
         Save/Cancel): the description is the flexible row, so it receives exactly the leftover space -
         about 110 px, five lines, and the description input never lets its own text grow past that:
         what does not fit is refused while typing, so only a value restored from the database is ever
         shown scrolled. Editing never grows the card. The 17 px above 300
         are two things:
         12 px compensate the editor bottom bar, which sits 12 px higher so that its buttons keep the
         same 16 px bottom padding as the action buttons in read mode, and 5 px are given to the
         description so a full-length text fits in the leftover space instead of pushing the
         card (which has only a MinHeight) taller. -->
    <x:Double x:Key="MealCardMinHeight">317</x:Double>
    <x:Double x:Key="CardCornerRadiusValue">12</x:Double>
    <x:Double x:Key="PageMaxContentWidth">1440</x:Double>
    <x:Double x:Key="CardSpacing">16</x:Double>

    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource CardStrokeColorDefault}" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="{ThemeResource TextFillColorSecondary}" />
    <!-- Frame of the photograph gallery. CardStrokeColorDefault is a ~7 % tint that disappears on a
         card, which is why the borders around the photos were not visible: this one is the strong
         control stroke (a solid grey in light theme and a solid light grey in dark theme), so every
         tile and the group around it are always outlined. -->
    <SolidColorBrush x:Key="GalleryBorderBrush" Color="{ThemeResource ControlStrongStrokeColorDefault}" />
    <!-- Backdrop behind a thumbnail: shown while the image is missing or still loading. -->
    <SolidColorBrush x:Key="GalleryFillBrush" Color="{ThemeResource ControlFillColorSecondary}" />
    <!-- Faint tint painted over a tile while the pointer is on it (the standard image-card hover). -->
    <SolidColorBrush x:Key="GalleryHoverBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
    <!-- The delete badge is a translucent dark square with a white cross: readable over any photograph
         in either theme, it turns red on hover because it removes something, and its square shape
         echoes the tile it belongs to (a disc looked like a separate floating control). -->
    <SolidColorBrush x:Key="PhotoDeleteBadgeBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="PhotoDeleteBadgeHoverBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="PhotoDeleteBadgePressedBrush" Color="#FFA32525" />
    <!-- Track behind the statistics bars: the theme's control stroke colour, so the unfilled part
         of the bar stays visible on dark and light backgrounds alike (a plain white tint would
         disappear on a white card in light mode). -->
    <SolidColorBrush x:Key="BarTrackBrush" Color="{ThemeResource ControlStrokeColorDefault}" />
    <!-- Literal colour on purpose: theme lookups for AccentFillColorDefault are not available in every
         WinAppSDK version and fail at render time, which used to take the application down. -->
    <SolidColorBrush x:Key="AccentStatusBrush" Color="#FF0F6CBD" />

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,12,0,8" />
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MealCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="StatusPillStyle" TargetType="Border">
        <!-- The status badge is no longer a full capsule: it is gently rounded with the same
             feel as the card's own corners instead of the pill radius. -->
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,2,10,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="ProgressCardStyle" TargetType="Border" BasedOn="{StaticResource MealCardStyle}">
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Day cell of the month calendar: the border never changes on hover (it carries the day
         state color), only a subtle shade appears over the background, exactly like the Microsoft
         calendar. Without this template the default Button style would repaint the border on hover. -->
    <Style x:Key="CalendarDayButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="BorderThickness" Value="2" />
        <!-- Equal padding on every side: a corner text (day number, percentage) then sits at the
             same distance from the two borders it touches - left/top for the number, left/bottom
             for the percentage (12 padding + 2 border = 14 all round). -->
        <Setter Property="Padding" Value="12,12" />
        <!-- No MinHeight: the height of a day cell comes from the page (the height of its row, at
             most as wide as the cell is), so the whole month always fits the panel. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!-- The content must fill the whole square (the default is Top, which would pack the day
             number and the percentage at the top of the taller cell): only a filled content grid
             can place the number above the middle and the percentage dead centre. -->
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            x:Name="RootBorder"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <!-- The only hover feedback: a faint shade over the background. -->
                        <Border
                            x:Name="HoverShade"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{ThemeResource ButtonBackgroundPointerOver}"
                            Opacity="0" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverShade"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverShade"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.5"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootBorder"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.5"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =====================================================================
         Photograph gallery (image-card pattern).
         A tile is a square, rounded, grey-bordered image button: the whole tile opens the photograph
         full size and the delete badge floats in its top-right corner. The states are driven by the
         visual states of the template, so the gallery reads the same in light and dark theme.
         ===================================================================== -->

    <!-- One thumbnail of the gallery: grey frame, rounded corners, faint tint on hover. -->
    <Style x:Key="PhotoTileStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GalleryFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GalleryBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <!-- The only hover feedback: a faint shade over the photograph. -->
                        <Border
                            x:Name="HoverShade"
                            Background="{StaticResource GalleryHoverBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0"
                            IsHitTestVisible="False" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverShade" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverShade" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The X badge that removes one photograph: always visible, so it also works with a finger, and
         it turns red on hover because what it does is destructive. -->
    <Style x:Key="PhotoDeleteButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource PhotoDeleteBadgeBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- Square badge (a small radius only, so it still belongs to the rounded tile row). -->
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Margin="{TemplateBinding Padding}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PhotoDeleteBadgeHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PhotoDeleteBadgePressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
