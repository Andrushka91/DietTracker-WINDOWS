<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DietTracker.App.Controls.MealCardEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DietTracker.App.Controls"
    xmlns:vm="using:DietTracker.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <TextBox x:Uid="Meal_Title" Header="Title" Text="{x:Bind Card.Title, Mode=TwoWay}" />
        <TextBox
            x:Uid="Meal_Ingredients"
            Header="Food description"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            Height="60"
            Text="{x:Bind Card.Ingredients, Mode=TwoWay}" />
        <TextBox
            x:Uid="Meal_Notes"
            Header="Notes"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            Height="52"
            Text="{x:Bind Card.Notes, Mode=TwoWay}" />

        <controls:UniformWrapPanel UniformHeight="False" MinItemWidth="96" HorizontalSpacing="8" VerticalSpacing="8">
            <TimePicker
                x:Uid="Meal_PlannedTime"
                Header="Planned time"
                ClockIdentifier="24HourClock"
                Time="{x:Bind Card.PlannedTimeEditor, Mode=TwoWay}" />
            <Button
                x:Uid="Meal_AddIngredient"
                Content="Add ingredient"
                VerticalAlignment="Bottom"
                Command="{x:Bind Card.AddIngredientLineCommand}" />
            <Button
                x:Uid="Photo_Add"
                Content="Add photo"
                VerticalAlignment="Bottom"
                Command="{x:Bind Card.AddPhotoCommand}" />
        </controls:UniformWrapPanel>

        <ItemsControl ItemsSource="{x:Bind Card.Quantities}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:IngredientLineViewModel">
                    <controls:IngredientLineEditor Line="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <InfoBar
            Severity="Warning"
            IsClosable="False"
            Message="{x:Bind Card.ErrorMessage, Mode=OneWay}"
            IsOpen="{x:Bind Card.HasError, Mode=OneWay}"
            Visibility="{x:Bind Card.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button
                x:Uid="Common_Save"
                Content="Save"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind Card.SaveCommand}" />
            <Button x:Uid="Common_Cancel" Content="Cancel" Command="{x:Bind Card.CancelCommand}" />
            <ProgressRing IsActive="{x:Bind Card.IsBusy, Mode=OneWay}" Width="20" Height="20" />
        </StackPanel>
    </StackPanel>
</UserControl>
