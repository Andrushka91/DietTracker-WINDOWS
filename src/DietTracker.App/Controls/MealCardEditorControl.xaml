<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DietTracker.App.Controls.MealCardEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DietTracker.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Uid="Meal_Title" Header="Title" Text="{x:Bind Card.Title, Mode=TwoWay}" />

        <!-- Food description: takes all the leftover space of the card's fixed height (MinHeight is
             sized so title, description and the bottom bar fit together) and scrolls internally when
             the text is longer than that space, so a long meal plan never grows the card. -->
        <TextBox
            Grid.Row="1"
            x:Uid="Meal_Ingredients"
            Header="Food description"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            MinHeight="44"
            VerticalAlignment="Stretch"
            Text="{x:Bind Card.Ingredients, Mode=TwoWay}" />

        <InfoBar
            Grid.Row="2"
            Severity="Warning"
            IsClosable="False"
            Message="{x:Bind Card.ErrorMessage, Mode=OneWay}"
            IsOpen="{x:Bind Card.HasError, Mode=OneWay}"
            Visibility="{x:Bind Card.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <!-- Bottom bar of the editor, kept compact so the description keeps the room: the "Time"
             label sits inline beside a slim input (no tall header), with the photo button next to
             it on the bottom-left and the Save / Cancel buttons pinned to the right edge.
             The top margin pushes the row down close to the card's bottom end: below it stays the
             card's 16 px bottom padding (a small gap, not glued to the edge), above it the larger
             gap to the description - so the row reads as the card's footer strip. -->
        <Grid Grid.Row="3" ColumnSpacing="8" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                <TextBlock x:Uid="Meal_TimeLabel" Text="Time" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                <!-- The time is typed as plain digits ("HH:MM", 24 hour); the clock flyout of the WinUI
                     TimePicker is avoided on purpose (it crashes on confirm and is heavy for this input).
                     The width is exactly enough for the five typed characters. -->
                <TextBox
                    AutomationProperties.Name="Time"
                    Width="72"
                    MaxLength="5"
                    InputScope="Number"
                    PlaceholderText="HH:MM"
                    VerticalAlignment="Bottom"
                    TextChanged="OnPlannedTimeTextChanged"
                    Text="{x:Bind Card.PlannedTimeText, Mode=TwoWay}" />
                <!-- Photo glyph with the upload arrow layered on top: the Segoe icon glyphs share one
                     fixed origin and are designed to overlay, composing a single "upload photo" mark.
                     Bottom-aligned so the button lines up with the time input box. -->
                <Button
                    x:Uid="Photo_Add"
                    VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="Add photo"
                    AutomationProperties.Name="Add photo"
                    Command="{x:Bind Card.AddPhotoCommand}">
                    <Grid Width="20" Height="20">
                        <FontIcon Glyph="&#xE91B;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE898;" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,1" />
                    </Grid>
                </Button>
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
                <Button
                    x:Uid="Common_Save"
                    Content="Save"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind Card.SaveCommand}" />
                <Button x:Uid="Common_Cancel" Content="Cancel" Command="{x:Bind Card.CancelCommand}" />
                <ProgressRing IsActive="{x:Bind Card.IsBusy, Mode=OneWay}" Width="20" Height="20" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
