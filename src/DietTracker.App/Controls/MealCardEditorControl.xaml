<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DietTracker.App.Controls.MealCardEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DietTracker.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <TextBox x:Uid="Meal_Title" Header="Title" Text="{x:Bind Card.Title, Mode=TwoWay}" />
        <TextBox
            x:Uid="Meal_Ingredients"
            Header="Food description"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            Height="110"
            Text="{x:Bind Card.Ingredients, Mode=TwoWay}" />

        <InfoBar
            Severity="Warning"
            IsClosable="False"
            Message="{x:Bind Card.ErrorMessage, Mode=OneWay}"
            IsOpen="{x:Bind Card.HasError, Mode=OneWay}"
            Visibility="{x:Bind Card.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <!-- Bottom bar of the editor: the planned time (with its photo button, their usual corner)
             stays in the bottom-left position while the Save / Cancel buttons are pinned to the
             right edge; the middle column absorbs the free space between them. -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <!-- The time is typed as plain digits ("HH:MM", 24 hour); the clock flyout of the WinUI
                     TimePicker is avoided on purpose (it crashes on confirm and is heavy for this input).
                     The width is exactly enough for the five typed characters. -->
                <TextBox
                    x:Uid="Meal_PlannedTime"
                    Header="Time"
                    Width="72"
                    MaxLength="5"
                    InputScope="Number"
                    PlaceholderText="HH:MM"
                    TextChanged="OnPlannedTimeTextChanged"
                    Text="{x:Bind Card.PlannedTimeText, Mode=TwoWay}" />
                <!-- Photo glyph with the upload arrow layered on top: the Segoe icon glyphs share one
                     fixed origin and are designed to overlay, composing a single "upload photo" mark.
                     Bottom-aligned so the button lines up with the time INPUT box; without it the
                     button centres against the whole field including its "Time" header and floats
                     above the input. No padding override, so it keeps the standard button height. -->
                <Button
                    x:Uid="Photo_Add"
                    VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="Add photo"
                    AutomationProperties.Name="Add photo"
                    Command="{x:Bind Card.AddPhotoCommand}">
                    <Grid Width="20" Height="20">
                        <FontIcon Glyph="&#xE91B;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE898;" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,1" />
                    </Grid>
                </Button>
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
                <Button
                    x:Uid="Common_Save"
                    Content="Save"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind Card.SaveCommand}" />
                <Button x:Uid="Common_Cancel" Content="Cancel" Command="{x:Bind Card.CancelCommand}" />
                <ProgressRing IsActive="{x:Bind Card.IsBusy, Mode=OneWay}" Width="20" Height="20" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
