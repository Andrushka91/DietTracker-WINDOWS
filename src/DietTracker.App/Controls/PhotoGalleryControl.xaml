<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DietTracker.App.Controls.PhotoGalleryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DietTracker.App.Controls"
    xmlns:vm="using:DietTracker.App.ViewModels">

    <!-- The photograph gallery of one meal card, built on the standard image-card pattern used by the
         Windows photo pickers: a grey framed group whose header names the collection and shows
         "n/3", holding square 1:1 tiles that flow left to right and wrap (UniformWrapPanel), each tile
         a rounded, grey-bordered thumbnail.
           * tapping a tile opens the photograph full size (the lightbox step of the pattern),
           * the X badge floating in the top-right corner of a tile removes it - always visible, so it
             works with a finger as well as with a pointer,
           * the frame only exists when the meal really has photographs, and the whole gallery collapses
             while the inline editor is open, so the card keeps exactly the same height in both modes.
         Thumbnails are generated at 256 px, so the 104 px tiles stay sharp. -->
    <Grid Visibility="{x:Bind Card.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
        <Border
            Margin="0,0,0,8"
            Padding="6"
            HorizontalAlignment="Left"
            BorderBrush="{StaticResource GalleryBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{x:Bind Card.HasPhotos, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Spacing="6">
                <!-- Group header: what this strip is and how full it still can get. -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        Glyph="&#xE91B;"
                        FontSize="12"
                        Foreground="{StaticResource SubtleTextBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Style="{StaticResource CaptionStyle}"
                        Text="{x:Bind Card.GalleryHeader, Mode=OneWay}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Style="{StaticResource CaptionStyle}"
                        Text="{x:Bind Card.PhotoLimitText, Mode=OneWay}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind Card.Photos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:UniformWrapPanel
                                UniformHeight="False"
                                MinItemWidth="104"
                                HorizontalSpacing="6"
                                VerticalSpacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MealPhotoViewModel">
                            <Grid Width="104" Height="104">
                                <Button
                                    Style="{StaticResource PhotoTileStyle}"
                                    Click="OnOpenPhoto"
                                    Tag="{x:Bind}"
                                    AutomationProperties.Name="Open photo"
                                    ToolTipService.ToolTip="Open photo">
                                    <Grid>
                                        <!-- Placeholder painted behind the thumbnail: it shows through
                                             when the image is still missing (an import interrupted by a
                                             crash or a download that has not arrived yet). -->
                                        <FontIcon
                                            Glyph="&#xEB9F;"
                                            FontSize="28"
                                            Foreground="{StaticResource SubtleTextBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <Image Stretch="UniformToFill" Source="{x:Bind ThumbnailPath}" />
                                    </Grid>
                                </Button>
                                <Button
                                    Style="{StaticResource PhotoDeleteButtonStyle}"
                                    Margin="0,4,4,0"
                                    Click="OnDeletePhoto"
                                    Tag="{x:Bind}"
                                    AutomationProperties.Name="Delete photo"
                                    ToolTipService.ToolTip="Delete photo">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="White" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
