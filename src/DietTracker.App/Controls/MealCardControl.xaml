<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DietTracker.App.Controls.MealCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DietTracker.App.Controls">

    <!-- One permanent meal card. Every card shares the same structure and the same height; nothing
         scrolls inside a card: long text is trimmed instead, so the whole day stays readable at a
         glance (see DashboardPage, where the cards are laid out by UniformWrapPanel). -->
    <Border
        Style="{StaticResource MealCardStyle}"
        MinHeight="{StaticResource MealCardMinHeight}"
        BorderBrush="{x:Bind Card.CardBorderBrush, Mode=OneWay}"
        BorderThickness="1,1,1,4">

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: the permanent category can be customized but never deleted. The icon is
                 nudged a few pixels up so its optical centre sits in line with the meal name and the
                 planned-time stamp below it (emoji glyphs carry their own whitespace and render low
                 when perfectly centred), and 10 px left so the glyph's ink starts exactly where the
                 inputs below start - emoji shapes carry ~10 px of built-in left side bearing that
                 would otherwise indent the icon relative to the fields. -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="{x:Bind Card.Icon}" FontFamily="{x:Bind Card.IconFontFamily}" FontSize="36" Margin="-10,-6,0,6" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Card.CategoryName}" FontWeight="SemiBold" />
                    <TextBlock
                        Style="{StaticResource CaptionStyle}"
                        Text="{x:Bind Card.EffectivePlannedTime, Converter={StaticResource TimeOnly}}" />
                </StackPanel>

                <Border
                    Grid.Column="2"
                    Style="{StaticResource StatusPillStyle}"
                    VerticalAlignment="Top"
                    Background="{x:Bind Card.StatusPillBrush, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon
                            Glyph="{x:Bind Card.StatusGlyph, Mode=OneWay}"
                            FontSize="12"
                            Foreground="White" />
                        <TextBlock Text="{x:Bind Card.StatusText, Mode=OneWay}" FontSize="12" Foreground="White" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Inline editor: shown inside the card, no navigation required. It fills row 1 (the
                 flexible row): while editing the action-bar row below collapses, so the editor
                 takes over that space as well - and the card's MinHeight guarantees room for every
                 field (title, description, time, photo, Save/Cancel), so editing never grows it. -->
            <Grid
                x:Name="EditorPanel"
                Grid.Row="1"
                VerticalAlignment="Stretch"
                Visibility="{x:Bind Card.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <controls:MealCardEditorControl Card="{x:Bind Card}" />
            </Grid>

            <!-- Read mode -->
            <StackPanel
                x:Name="ReadPanel"
                Grid.Row="1"
                Spacing="6"
                VerticalAlignment="Top"
                Visibility="{x:Bind Card.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <!-- Read-mode messages (e.g. "photo was already uploaded" from the action bar's
                     add-photo button); closable, because nothing else clears an error here. While
                     editing the ReadPanel is collapsed and the editor's own InfoBar takes over. -->
                <InfoBar
                    Severity="Warning"
                    IsClosable="True"
                    Closing="OnReadInfoBarClosing"
                    Message="{x:Bind Card.ErrorMessage, Mode=OneWay}"
                    IsOpen="{x:Bind Card.HasError, Mode=OneWay}"
                    Visibility="{x:Bind Card.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    Text="{x:Bind Card.Title, Mode=OneWay}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Text="{x:Bind Card.Ingredients, Mode=OneWay}"
                    TextWrapping="Wrap"
                    MaxLines="3"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Photograph gallery: a grey framed grid of square thumbnails, every tile with its own
                 X badge to remove it. The gallery collapses while the inline editor is open and it is
                 absent for a meal without photographs - the layout itself lives in PhotoGalleryControl
                 so the card keeps describing content, not pixels. -->
            <controls:PhotoGalleryControl
                Grid.Row="2"
                Card="{x:Bind Card}" />

            <!-- Bottom row of the card: the action buttons on the left and the confirmation stamp
                 in the bottom right corner, both in the same full-width cell so the button row keeps
                 its original width (in a sized column the photo button would wrap). Hidden while the
                 inline editor is open, exactly like the read mode above. -->
            <Grid
                Grid.Row="3"
                Visibility="{x:Bind Card.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <controls:MealCardActionsControl
                    x:Name="ActionsRow"
                    Card="{x:Bind Card}" />

                <TextBlock
                    Style="{StaticResource CaptionStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis"
                    Text="{x:Bind Card.CompletedAtText, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
