<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DietTracker.App.Controls.MealCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DietTracker.App.Controls"
    xmlns:vm="using:DietTracker.App.ViewModels">

    <!-- One permanent meal card. Every card shares the same structure and the same height; nothing
         scrolls inside a card: long text is trimmed instead, so the whole day stays readable at a
         glance (see DashboardPage, where the cards are laid out by UniformWrapPanel). -->
    <Border
        Style="{StaticResource MealCardStyle}"
        MinHeight="{StaticResource MealCardMinHeight}"
        BorderBrush="{x:Bind Card.Color, Converter={StaticResource HexToBrush}}"
        BorderThickness="1,1,1,4">

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: the permanent category can be customized but never deleted -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="{x:Bind Card.Icon}" FontSize="20" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Card.CategoryName}" FontWeight="SemiBold" />
                    <TextBlock
                        Style="{StaticResource CaptionStyle}"
                        Text="{x:Bind Card.EffectivePlannedTime, Converter={StaticResource TimeOnly}}" />
                </StackPanel>

                <Border
                    Grid.Column="2"
                    Style="{StaticResource StatusPillStyle}"
                    VerticalAlignment="Top"
                    Background="{x:Bind Card.Status, Mode=OneWay, Converter={StaticResource MealStatusToBrush}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon
                            Glyph="{x:Bind Card.Status, Mode=OneWay, Converter={StaticResource MealStatusToGlyph}}"
                            FontSize="12"
                            Foreground="White" />
                        <TextBlock Text="{x:Bind Card.StatusText, Mode=OneWay}" FontSize="12" Foreground="White" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Inline editor: shown inside the card, no navigation required -->
            <Grid
                x:Name="EditorPanel"
                Grid.Row="1"
                VerticalAlignment="Top"
                Visibility="{x:Bind Card.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <controls:MealCardEditorControl Card="{x:Bind Card}" />
            </Grid>

            <!-- Read mode -->
            <StackPanel
                x:Name="ReadPanel"
                Grid.Row="1"
                Spacing="6"
                VerticalAlignment="Top"
                Visibility="{x:Bind Card.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <TextBlock
                    Text="{x:Bind Card.Title, Mode=OneWay}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Text="{x:Bind Card.Ingredients, Mode=OneWay}"
                    TextWrapping="Wrap"
                    MaxLines="3"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Style="{StaticResource CaptionStyle}"
                    Text="{x:Bind Card.QuantitiesSummary, Mode=OneWay}"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Style="{StaticResource CaptionStyle}"
                    Text="{x:Bind Card.CompletedAtText, Mode=OneWay}"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Photographs are optional; a meal can always be marked DONE without one -->
            <ItemsControl x:Name="PhotosRow" Grid.Row="2" ItemsSource="{x:Bind Card.Photos}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:UniformWrapPanel
                            UniformHeight="False"
                            MinItemWidth="52"
                            HorizontalSpacing="6"
                            VerticalSpacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MealPhotoViewModel">
                        <Button Padding="0" BorderThickness="0" Background="Transparent" Click="OnOpenPhoto" Tag="{x:Bind}">
                            <Image Width="52" Height="52" Stretch="UniformToFill" Source="{x:Bind ThumbnailPath}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <controls:MealCardActionsControl
                x:Name="ActionsRow"
                Grid.Row="3"
                Card="{x:Bind Card}"
                Visibility="{x:Bind Card.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        </Grid>
    </Border>
</UserControl>
