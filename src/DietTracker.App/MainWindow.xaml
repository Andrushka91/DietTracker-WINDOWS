<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DietTracker.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Synchronization status strip: never claims "Synced" before the provider confirmed it.
             A confirmation hides itself after a few seconds (see MainWindow.Notifications.cs), a
             warning or an error stays until it is resolved; hovering the strip pauses the countdown. -->
        <InfoBar
            x:Name="StatusBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational"
            PointerEntered="OnStatusBarPointerEntered"
            PointerExited="OnStatusBarPointerExited" />

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            OpenPaneLength="248"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DashboardItem" Content="Dashboard" Tag="dashboard" x:Uid="Nav_Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Calendar" Tag="calendar" x:Uid="Nav_Calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Statistics" Tag="statistics" x:Uid="Nav_Statistics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Templates" Tag="templates" x:Uid="Nav_Templates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings" x:Uid="Nav_Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Busy overlay: a dark, translucent scrim above the whole window (including the status
             strip and the navigation), with a spinner and a sentence about what is happening. It is
             the single place where signing in, signing out, synchronizing and restoring report their
             progress; while it blocks closing, the caption bar close button is ignored as well. -->
        <Grid
            x:Name="BusyOverlay"
            Grid.RowSpan="2"
            Background="#C2000000"
            Opacity="0"
            Visibility="Collapsed"
            AutomationProperties.Name="Busy">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18"
                MaxWidth="520"
                Padding="24">
                <ProgressRing
                    x:Name="BusyRing"
                    Width="72"
                    Height="72"
                    IsActive="False"
                    IsIndeterminate="True"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock
                    x:Name="BusyMessage"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="White"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Assertive" />
                <TextBlock
                    x:Name="BusyHint"
                    FontSize="13"
                    Foreground="#B3FFFFFF"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
