<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>DietTracker.App</RootNamespace>
    <AssemblyName>DietTracker</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DietTracker.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <!-- English is the only interface language. The other resource files stay in the repository so the
         strings of a future translation are already collected, but they are never selected at runtime
         (see App.SupportedLanguage). -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <ApplicationTitle>Diet Tracker</ApplicationTitle>
    <!-- FileDescription in the executable's version info (Task Manager, file properties) comes from
         AssemblyTitle; without it Windows shows the technical assembly name "DietTracker". -->
    <AssemblyTitle>Diet Tracker</AssemblyTitle>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackageDir>$(MSBuildThisFileDirectory)..\..\artifacts\msix\</AppxPackageDir>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <EnableDefaultPriItems>true</EnableDefaultPriItems>

    <!--
      Developer-friendly output location: the built application is written to dist/ at the repository
      root. dist/exec/ holds the optimized application you actually run ("exec" = executable); it is the
      default output of `npm start` / `npm run build`. dist/debug/ only exists for debugging sessions
      (unoptimized build with symbols) and is produced by the debug commands. The two never mix, so a
      debug build can never be mistaken for the real application.
    -->
    <AppDistFolder Condition="'$(Configuration)' == 'Debug'">debug</AppDistFolder>
    <AppDistFolder Condition="'$(Configuration)' != 'Debug'">exec</AppDistFolder>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\dist\$(AppDistFolder)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!--
    Unpackaged (developer) build: `dotnet build -p:WindowsPackageType=None -p:EnableMsixTooling=false`.
    The same source produces the Store-ready MSIX package by default.
  -->
  <PropertyGroup Condition="'$(WindowsPackageType)' == 'None'">
    <EnableMsixTooling>false</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DietTracker.Core\DietTracker.Core.csproj" />
    <ProjectReference Include="..\DietTracker.Infrastructure\DietTracker.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Namespaces used throughout the UI layer. -->
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="DietTracker.Core.Models" />
    <Using Include="DietTracker.Core.Enums" />
    <Using Include="DietTracker.Infrastructure.Authentication" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableMsixTooling)' == 'true'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Content Include="Assets\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableMsixTooling)' != 'true'">
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    A running DietTracker instance locks the DLLs in dist/, so the copy step of the build fails with
    MSB3027/MSB3021 ("being used by another process"). Stop the running instances before the build;
    the same protection that tools/Run-App.ps1 applies, but for every build command. The target is
    hooked to PrepareForBuild (which always runs early in the App project's pipeline, before the
    referenced assemblies are copied to dist) because WinUI overrides the Build target itself, so a
    BeforeTargets="Build" hook never fires. taskkill exits with 128 when no instance is running -
    that is not an error. The copy step's own retry logic (10 x 1 s) absorbs the short window until
    Windows releases the file handles.
  -->
  <Target Name="StopRunningAppInstances" BeforeTargets="PrepareForBuild;_CopyFilesMarkedCopyLocal">
    <Exec Command="taskkill /IM DietTracker.exe /F" IgnoreExitCode="true" ContinueOnError="true" />
  </Target>

</Project>
